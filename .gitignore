# --- python ---
*.egg-info/
__pycache__/
*.pyc
.venv/


# --- os / editor ---
.DS_Store
.chrome-profile/

# --- run outputs (no trailing slash: in a linked worktree these are symlinks to the primary checkout) ---
/logs
/runs
marginal.toml

# --- data: fetched + built, verified by data/SHA256SUMS.variants ---
# rebuild with scripts/fetch_data.sh && scripts/build_data.sh
/data/raw
/data/augmented
/data/mythos5
/data/rubyhack
/data/transluce
/data/urlquery
data/raw_stripped/*
!data/raw_stripped/.gitkeep
data/verbatim/*
!data/verbatim/.gitkeep
data/verbatim_anthropic/*
!data/verbatim_anthropic/.gitkeep

# --- raw agent transcripts (multi-MB, not needed to reproduce grades) ---
baselines/*/transcript.jsonl
reports/**/transcript.jsonl
# Raw URLQuery exports can quote recorded secrets. Only reviewed publication copies are tracked.
/reports/urlquery/*
!/reports/urlquery/published/
/reports/urlquery/published/*
!/reports/urlquery/published/*.md
# Private hosted report sources and generated publication bundles.
/reports/share-site

# --- generated viewers: rebuild with viewers/build_*.py ---
viewers/*.html
!viewers/coverage_combined.html
# Local URLQuery review comments can quote the retained credential evidence too.
viewers/data/urlquery-*-review.json
!viewers/transluce_explorer.template.html
!viewers/urlquery_findings.template.html
!viewers/urlquery_findings.limits.html
viewers/scratch/
# per-pin sandbox Dockerfiles generated by the Inspect task (messageboard_audit_bench/task.py)
sandbox/docker/.generated/
# per-report payloads for audit.html; rebuilt by build_audit_ui.py
viewers/data/audit/
viewers/data/audit_v2/
# TL;DR grading payload + the human excerpt; rebuilt by build_tldr_human_ui.py
viewers/data/tldr/
# provider-swap report payloads; rebuilt by build_pswap_reader_ui.py
viewers/data/pswap/


.env
# --- linked task worktrees (see AGENTS.md) ---
.worktrees/

# --- partner-supplied archives (large, untracked) ---
/incoming
viewers/data/urlquery_audit/
