# Copy to .env (gitignored). Inspect loads it automatically.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional defaults so you can omit --model / --model-role on the command line.
# INSPECT_EVAL_MODEL=anthropic/claude-sonnet-5
# INSPECT_LOG_DIR=./logs

# Use a Claude subscription instead of an API key: paste the token from `claude setup-token`.
# Inspect then sends it as a Bearer token (and ignores ANTHROPIC_API_KEY).
ANTHROPIC_AUTH_TOKEN=
