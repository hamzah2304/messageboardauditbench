# Copy to .env (gitignored). The graders in benchmark/rubrics/ load this file;
# Use `uv run --env-file .env inspect eval ...` to load it for Inspect.

# 30-claim grader: GPT-5.6 Sol judge (the default)
OPENAI_API_KEY=
# Direct Anthropic API models (agent or explicitly selected grader)
ANTHROPIC_API_KEY=
# OpenRouter models (agent or explicitly selected grader)
OPENROUTER_API_KEY=
# Claude Code trials; runs/.claude-oauth-token is preferred over this
# CLAUDE_CODE_OAUTH_TOKEN=
