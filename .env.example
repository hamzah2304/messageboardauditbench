# Copy to .env (gitignored). The graders in benchmark/rubrics/ load this file;
# the Inspect scorer and the sandbox read the same names from the environment.

# 30-claim grader: GPT-5.6 Sol judge (the default)
OPENAI_API_KEY=
# Inspect rubric_scorer default judge, or MODEL=claude-... for the 30-claim grader
ANTHROPIC_API_KEY=
# ReAct scaffold (agent=react); runs/.openrouter_key also works
OPENROUTER_API_KEY=
# Claude Code trials; runs/.claude-oauth-token is preferred over this
# CLAUDE_CODE_OAUTH_TOKEN=
